        {
            "parameters": {
                "jsCode": "// Prepare Input for ffmpeg_proxy\nconst segment = $json.prompt_parsed; // The split item puts the prompt object here\nconst filterConfig = $json.filter_config;\n\n// Global Context from upstream\nconst globalCtx = $('Code in JavaScript').first().json;\n\nconst context = {\n    channel_name: globalCtx.channel_name,\n    bucket_name: globalCtx.bucket_name,\n    workspace_folder: globalCtx.workspace_folder,\n    s3_url: globalCtx.s3_url,\n    default_voice: globalCtx.default_voice,\n    voice_reference: globalCtx.voice_reference\n};\n\nreturn {\n    json: {\n        segment: segment,\n        filter_config: filterConfig,\n        context: context,\n        need_audio: true,\n        auto_background: true\n    }\n};"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                -656
            ],
            "id": "prepare_proxy_input",
            "name": "Prepare Proxy Input"
        },
        {
            "parameters": {
                "workflowId": "1ae252ac-23cc-4050-820a-7d27c208c336",
                "mode": "each"
            },
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1,
            "position": [
                400,
                -656
            ],
            "id": "execute_ffmpeg_proxy",
            "name": "Call ffmpeg_proxy"
        },
        {
            "parameters": {
                "jsCode": "// Collect Results and Prepare Final Concat\n// The input items here are the results from the sub-workflow (one per segment)\n\nconst inputs = items.map(item => {\n    // Assuming sub-workflow returns 'response' from compose, or constructing it.\n    // We need the file_url of the generated segment.\n    // If your sub-workflow 'MergeImageAndAudio' returns { response: [{ file_url: ... }] }\n    const resp = item.json.response && item.json.response[0];\n    const url = resp ? resp.file_url : item.json.video_url; // fallback if you change output\n    \n    if (!url) throw new Error(\"Sub-workflow did not return a valid video URL\");\n    \n    return { file_url: url };\n});\n\n// Call buildComposeConcat (Internal function logic)\nfunction buildComposeConcat(inputs, opts = {}) {\n   const { targetFps=30, id=\"final.mp4\" } = opts;\n   const n = inputs.length;\n   const interleaved = [];\n   for (let i = 0; i < n; i++) interleaved.push(`[${i}:v]`, `[${i}:a]`);\n   \n   const concatExpr = `${interleaved.join(\"\")}concat=n=${n}:v=1:a=1[v][a];[v]fps=${targetFps},format=yuv420p[v]`;\n   \n   return {\n       inputs: inputs,\n       outputs: [{\n           options: [\n               { option: \"-filter_complex\", argument: concatExpr },\n               { option: \"-map\", argument: \"[v]\" },\n               { option: \"-map\", argument: \"[a]\" },\n               { option: \"-c:v\", argument: \"libx264\" },\n               { option: \"-c:a\", argument: \"aac\" },\n               { option: \"-shortedt\" }\n           ]\n       }],\n       global_options: [{ option: \"-y\" }],\n       id: id\n   };\n}\n\n// Construct the body\nconst globalCtx = $('Code in JavaScript').first().json;\nconst finalId = `final_video_${globalCtx.workspace_folder}.mp4`;\n\nconst body = buildComposeConcat(inputs, { id: finalId });\n\nreturn [\n    {\n        json: {\n            combine_request_body: body\n        }\n    }\n];"
            },
