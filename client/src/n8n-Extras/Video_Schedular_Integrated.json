                "fieldToSplitOut": "prompt_parsed",
                "include": "selectedOtherFields",
                "fieldsToInclude": "filter_config",
                "options": {}
            },
            "type": "n8n-nodes-base.splitOut",
            "typeVersion": 1,
            "position": [
                -48,
