{
    "name": "Video_Schedular_Integrated",
    "nodes": [
        {
            "parameters": {
                "jsCode": "// Generate a simple UUID v4\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = (Math.random() * 16) | 0;\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\n// Get Channel Data\nconst channelData = $('Get Channel').first().json;\n\n// Get timestamp\nconst now = new Date();\nconst yyyymmdd = now.toISOString().slice(0,10).replace(/-/g, '');\nconst hh = String(now.getHours()).padStart(2, '0');\nconst mm = String(now.getMinutes()).padStart(2, '0');\nconst ss = String(now.getSeconds()).padStart(2, '0');\nconst sss = String(now.getMilliseconds()).padStart(3, '0');\nconst timestamp = `${hh}-${mm}-${ss}-${sss}`;\n\n// Define Workspace Folder\nconst workspace_folder = `${yyyymmdd}-${timestamp}`.trim();\n\n// Extract Global Context\nconst bucket_name = channelData.bucket_name.trim();\nconst channel_name = channelData.channel_path.trim();\nconst s3_url = channelData.s3_url.trim();\nconst nca_toolkit_url = channelData.nca_toolkit_url.trim();\nconst sheet_name = channelData.sheet_name.trim();\nconst default_voice = channelData.default_voice;\nconst voice_reference = channelData.voice_reference;\n\nreturn [\n  {\n    json: {\n      workspace_folder,\n      bucket_name,\n      channel_name,\n      s3_url,\n      nca_toolkit_url,\n      sheet_name,\n      default_voice,\n      voice_reference\n    }\n  }\n];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -656,
                -736
            ],
            "id": "16405018-7649-4118-b041-417d62824993",
            "name": "Code in JavaScript"
        },
        {
            "parameters": {
                "jsCode": "// Parse prompt_json string to JSON object\nfunction safeParse(str) {\n  try {\n    return JSON.parse(str);\n  } catch (e) {\n    return {};\n  }\n}\n\nlet promptArray = safeParse($('Get Idea').first().json.prompt_json);\n\nconst meta = safeParse($json.meta_config_json);\nconst visuals = safeParse($json.visual_config_json);\nconst texts = safeParse($json.text_config_json);\nconst audios = safeParse($json.audio_config_json);\nconst transitions = safeParse($json.transition_config_json);\nconst caption = safeParse($json.caption_config_json);\n\n// Merge into unified config\nconst filter_config = {\n  ...(meta || {}),\n  visual_overlays: visuals || {},\n  text_overlays: texts || {},\n  audio_overlays: audios || {},\n  caption_config: caption || {},\n  transitions_overlays: transitions || {}\n};\n\nreturn {\n  json: {\n    prompt_parsed: promptArray,\n    filter_config: filter_config\n  }\n};\n"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                -208,
                -736
            ],
            "id": "cd02ed21-a7b5-4444-a1f3-414d220702cb",
            "name": "parse to json"
        },
